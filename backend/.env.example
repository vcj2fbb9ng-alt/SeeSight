# SeeSight backend configuration — SANDBOX/TEST MODE ONLY. No real money ever moves.

PORT=4000

# Path to the SQLite database file (created automatically on first run).
DATABASE_PATH=./data/seesight.sqlite

# Directory where generated invoice PDFs are written.
INVOICES_DIR=./invoices

# Card issuing provider. Only "mock" is implemented in this prototype — it
# fabricates realistic-looking sandbox card data locally, no network calls,
# no real card-issuing account required. The code is structured so a real
# sandbox provider (Stripe Issuing test mode, Marqeta sandbox) can be dropped
# in behind the same interface — see src/services/cardIssuing/README.md.
CARD_PROVIDER=mock

# Shared secret this server expects on the `X-SeeSight-Webhook-Secret` header
# of inbound /api/webhooks/provider calls, simulating provider webhook auth.
WEBHOOK_SHARED_SECRET=dev-webhook-secret
